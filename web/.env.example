# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit the real values.

# Safe to expose to the browser — this is what @supabase/ssr's browser
# client and every RLS-respecting server query authenticate with.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row-Level Security entirely. Never prefix this with
# NEXT_PUBLIC_, never send it to the browser, never log it. Used only by
# lib/database/client.ts's createServiceRoleClient(), which is itself
# reserved for the handful of genuinely trusted server-only operations
# described in that file's docstring.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER-ONLY. Used by lib/ai/orchestrator.ts's createOrchestrator() to
# build the AnthropicProvider. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 3 (the public Diagnowise API) may add more here.

# AI providers (V2) — see docs/AI_PROVIDER_ARCHITECTURE.md. Unset = Anthropic only, as before.
# Comma-separated chain = failover in order. Per-stage override example below.
# AI_PROVIDER_DEFAULT=anthropic
# AI_PROVIDER_SAFETY_VERIFICATION=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GOOGLE_API_KEY=
# GOOGLE_MODEL=
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_MODEL=
# AI_LOCAL_API_KEY=

# Patient sign-up is closed until you set this to "true". Only do so AFTER a clinician has
# reviewed docs/PATIENT_COPY_FOR_CLINICAL_REVIEW.md. (UI-level gate; see APPLY notes.)
# PATIENT_SIGNUP_ENABLED=true

# AI-written possible diagnoses for patients are ON by default once patient sign-up is open.
# Set to "false" to switch them off (patients still get the fixed-copy guidance).
# PATIENT_DIAGNOSES_ENABLED=false
